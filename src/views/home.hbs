<!doctype html><html lang="en"><head>{{> head title=title}}</head><body>{{> header}}
<main>
<section class="hero"><div class="hero-overlay"></div><div class="container hero-content"><div class="hero-copy"><p class="eyebrow">TOGETHER FOR A BRIGHTER TOMORROW</p><h1>Giving Every Child <span>Hope, Education</span> &amp; A <b>Brighter Future</b></h1><p>Glory Children Ministry is an NGO dedicated to caring for orphans and street children, providing education, healthcare, nutritious food, guidance, counselling and opportunities to thrive.</p><div class="hero-actions"><a class="btn btn-primary btn-lg" href="#donate">♥ Donate Now</a><a class="btn btn-outline btn-lg" href="/causes">♟ Join Our Causes</a><a class="btn btn-purple btn-lg" href="#volunteer">Volunteer</a></div></div></div></section>
<section id="about" class="section intro"><div class="container"><p class="eyebrow pink-text">OUR CAUSES</p><h2>Changing Lives, <span>One Child</span> at a Time</h2><p class="section-lead">We provide holistic support to help vulnerable children grow, learn and build a better future. Our work responds to practical needs while nurturing dignity, confidence and hope.</p><div class="cause-grid">{{#each causes}}<article class="cause-card {{colorClass}}"><div class="cause-icon">{{icon}}</div><h3>{{title}}</h3><p>{{shortDescription}}</p><a href="/causes/{{slug}}">Learn More →</a></article>{{/each}}</div></div></section>
<section class="impact"><div class="container impact-inner"><div class="impact-copy"><p class="eyebrow">OUR IMPACT</p><h2>Together, we are creating lasting change.</h2><p>Every contribution helps us reach more children with practical care, protection, education and hope.</p></div><div class="stat"><strong>500+</strong><span>Children Supported</span></div><div class="stat"><strong>200+</strong><span>Children in School</span></div><div class="stat"><strong>100+</strong><span>Medical Support</span></div><div class="stat"><strong>50+</strong><span>Families Reunited</span></div></div></section>
<section id="get-involved" class="cta-section"><div class="container cta-card"><div><p class="eyebrow">MAKE A DIFFERENCE</p><h2>Your support can change a child's story.</h2><p>Donate, volunteer, partner with us or join one of our causes.</p></div><div class="hero-actions"><a class="btn btn-primary btn-lg" href="#donate">Donate Now</a><a class="btn btn-purple btn-lg" href="#volunteer">Volunteer</a><a class="btn btn-dark btn-lg" href="/contact">Join Our Causes</a></div></div></section>
<section id="gallery" class="section gallery-placeholder"><div class="container"><p class="eyebrow pink-text">GALLERY</p><h2>Moments of <span>Hope &amp; Joy</span></h2><div class="gallery-grid"><div>Children · Learning</div><div>Children · Community</div><div>Children · Play</div></div></div></section>
<section id="updates" class="section updates"><div class="container"><p class="eyebrow pink-text">NEWS &amp; UPDATES</p><h2>Stories from the work</h2><div class="story-grid"><article><span>UPDATE</span><h3>Creating safe spaces for vulnerable children</h3><p>Share field stories, programme updates and milestones from Glory Children Ministry.</p></article><article><span>STORY</span><h3>Education opens doors to opportunity</h3><p>Highlight the children, mentors and partners making learning possible.</p></article><article><span>IMPACT</span><h3>Community support that reaches further</h3><p>Show how donors and volunteers contribute to lasting change.</p></article></div></div></section>
</main>{{> footer}}</body></html>
